# Telegram
BUS_ALERT_TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Schedule and alert rules
TIMEZONE=Asia/Singapore
ALERT_WINDOW_START=08:30
ALERT_WINDOW_END=09:30
ALERT_THRESHOLD_MINUTES=8
COOLDOWN_MINUTES=3

# Data source
ARRIVAL_API_BASE=https://arrivelah2.busrouter.sg
WEATHER_LATITUDE=1.3179
WEATHER_LONGITUDE=103.7631
STATE_FILE=./state.json
# Primary runtime state lives in the sibling SQLite file (for example `state.db`).
# If this JSON file exists without the DB yet, the first run migrates it into SQLite once.

# Bus stops and services to monitor; Telegram service shortcuts are generated from these services
STOP_CONFIG_JSON=[{"stop_id":"17379","stop_name":"金文泰大牌304","services":["189"]},{"stop_id":"17051","stop_name":"丽晶园对面","services":["963"]}]
